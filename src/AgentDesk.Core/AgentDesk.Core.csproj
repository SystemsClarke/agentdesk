<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentDesk.Contracts\AgentDesk.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" /> <!-- the ops console (Host/Web.cs) -->
    <EmbeddedResource Include="Host/Web.html" LogicalName="AgentDesk.Core.Host.Web.html" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>AgentDesk</AssemblyTitle> <!-- the name Windows puts on the tray's toasts -->
    <ApplicationIcon>../../agentdesk/assets/agentdesk.ico</ApplicationIcon>
  </PropertyGroup>

</Project>

