<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-scoped: the machine config lists an offline source folder that doesn't exist,
     which fails every restore. This repo restores from nuget.org only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
